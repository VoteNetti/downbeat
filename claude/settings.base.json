{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$HOME/.claude/hooks/commit-msg-check.sh\"" },
          { "type": "command", "command": "bash \"$HOME/.claude/hooks/branch-protection.sh\"" },
          { "type": "command", "command": "bash \"$HOME/.claude/hooks/pull-before-push.sh\"" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(cat*)",
      "Bash(grep*)",
      "Bash(echo*)",
      "Bash(which*)",
      "Bash(uname*)",
      "Read",
      "Glob",
      "Grep",
      "mcp__github__get_file_contents",
      "mcp__github__list_branches",
      "mcp__github__list_commits",
      "mcp__github__list_issues",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__search_code",
      "mcp__github__search_issues",
      "mcp__github__search_pull_requests",
      "mcp__github__get_commit",
      "mcp__github__get_me"
    ]
  }
}
