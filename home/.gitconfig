# Managed by downbeat (symlinked from home/.gitconfig).
# My git preferences only. Identity and signing key are per person: install.sh writes them to
# ~/.gitconfig.local (not tracked), along with the 1Password signer or signing turned off.
# Use `git config --file ~/.gitconfig.local ...` rather than `--global`, which writes to this file.
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[include]
	path = ~/.gitconfig.local
