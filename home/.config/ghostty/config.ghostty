# --- Splits ---
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down

# --- Move between splits with arrows ---
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:up
keybind = super+alt+down=goto_split:down

# --- Optional: resize and zoom ---
keybind = super+ctrl+left=resize_split:left,20
keybind = super+ctrl+right=resize_split:right,20
keybind = super+ctrl+up=resize_split:up,20
keybind = super+ctrl+down=resize_split:down,20
keybind = super+shift+enter=toggle_split_zoom
keybind = super+shift+e=toggle_split_zoom
keybind = super+ctrl+equal=equalize_splits

# --- Theme ---
theme = iTerm2 Solarized Dark
window-colorspace = "display-p3"
unfocused-split-opacity = 0.6
unfocused-split-fill = #000000
split-divider-color = #586e75

# --- Fonts ---
font-family = JetBrainsMono Nerd Font

# --- Global ---
keybind = global:cmd+alt+backquote=toggle_quick_terminal

# --- Per-machine overrides (untracked), relative to this file
config-file = ?config.local.ghostty
